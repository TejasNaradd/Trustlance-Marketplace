# ──────────────────────────────────────────────────────────────────────────────
# TrustLance Environment Variables
# Copy this file to .env and fill in values before running docker-compose.
# NEVER commit .env to git — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ─── MySQL ────────────────────────────────────────────────────────────────────
# Used by MySQL container and all MySQL-backed services.
# These values are hardcoded in docker-compose for dev — only change for prod.
MYSQL_ROOT_PASSWORD=rcoem
MYSQL_USER=root

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# No credentials in dev. MongoDB runs without auth.

# ─── Redis ────────────────────────────────────────────────────────────────────
# No credentials in dev.

# ─── MinIO ────────────────────────────────────────────────────────────────────
# Object storage for AI document uploads.
# Access console at http://localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=trustlance-documents

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be a 256-bit (64 hex chars) secret. Default below works for dev.
# Generate your own: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ─── Admin Bootstrap ──────────────────────────────────────────────────────────
# AdminSeeder creates this user on first startup if no admin exists yet.
# Login with these credentials at POST /api/v1/auth/login
# Change ADMIN_PASSWORD to something strong in production.
ADMIN_EMAIL=admin@trustlance.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234
ADMIN_FIRSTNAME=Platform
ADMIN_LASTNAME=Admin

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Required for AI document verification to work.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Only needed to test POST /api/v1/auth/google.
# All other auth (register/login with email) works without this.
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# ─── Payment ──────────────────────────────────────────────────────────────────
# Only matters when using a real Razorpay/Stripe webhook.
# MockPaymentProvider ignores this in dev.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# ─── SMTP Email ───────────────────────────────────────────────────────────────
# Leave SMTP_ENABLED=false during development.
# Notifications are saved to MongoDB and logged — no real emails sent.
# Set SMTP_ENABLED=true and fill credentials only when you want real emails.
# For Gmail: use an App Password (not your login password).
#   Google Account → Security → 2-Step Verification → App Passwords
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=noreply@trustlance.com
