# ═══════════════════════════════════════════════════════════════════════════════
# TrustLance Marketplace - Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 
# IMPORTANT: This is a template file. Copy this to .env and fill in your actual values.
# Never commit the actual .env file with real secrets to version control.
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Replace placeholder values with your actual credentials
#   3. Ensure .env is in .gitignore
#
# Last Updated: 2026-09-05
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Groq AI Configuration (AI Service) ───────────────────────────────────────
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Groq API Base URL (OpenAI-compatible endpoint)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq Model Selection
# Available models:
#   - llama3-70b-8192     (Recommended: 70B params, 8K context, fast inference)
#   - llama-3.1-70b-versatile
#   - mixtral-8x7b-32768
GROQ_MODEL=llama3-70b-8192

# Groq Generation Parameters
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1024
GROQ_TOP_P=0.95

# ─── AI Service Tuning ────────────────────────────────────────────────────────
# Confidence thresholds for verification decisions
AI_CONFIDENCE_AUTO_APPROVE=0.90
AI_CONFIDENCE_MANUAL_REVIEW=0.70

# Async processing thread pool configuration
AI_ASYNC_CORE_POOL=5
AI_ASYNC_MAX_POOL=10
AI_ASYNC_QUEUE=50

# ─── Database Configuration ───────────────────────────────────────────────────
# MongoDB (Used by: ai-service, review-service, dispute-service, notification-service)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/ai_db

# MySQL (Used by: user-service, marketplace-service, contract-service, payment-service, escrow-service)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trustlance_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# ─── Kafka Configuration ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── MinIO Object Storage (AI Service) ────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=trustlance-documents

# ─── JWT Security ─────────────────────────────────────────────────────────────
# Generate a secure random key: openssl rand -base64 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ─── Redis Cache (Escrow Service) ─────────────────────────────────────────────
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ─── Email Configuration (Notification Service) ───────────────────────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ─── Service Discovery & Config ───────────────────────────────────────────────
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ─── Logging Configuration ────────────────────────────────────────────────────
LOG_LEVEL=INFO
SPRING_AI_LOG_LEVEL=DEBUG

# ─── Application Environment ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ═══════════════════════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
