# ──────────────────────────────────────────────────────────────────────────────
# TrustLance Environment Variables
# Copy to .env and fill in real values for production.
# ──────────────────────────────────────────────────────────────────────────────

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=rcoem

# MongoDB
MONGO_USER=root
MONGO_PASSWORD=rootpass

# Redis (no auth needed in dev)

# Kafka (KRaft mode - no Zookeeper needed)

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT
TRUSTLANCE_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Google OAuth (for user-service Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
